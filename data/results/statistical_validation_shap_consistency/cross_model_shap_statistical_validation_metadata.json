{
    "analysis": "Statistical validation of cross-model SHAP consistency",
    "input": "unified_local_shap_consistency.csv",
    "shap_method": "Unified permutation SHAP",
    "prediction_output": "positive-class probability",
    "shap_observations": 300,
    "bootstrap_repetitions": 5000,
    "confidence_level": 0.95,
    "random_state": 42,
    "alpha": 0.05,
    "model_pairs": [
        "RF-XGB",
        "RF-LGBM",
        "RF-MLP",
        "XGB-LGBM",
        "XGB-MLP",
        "LGBM-MLP"
    ],
    "statistical_tests": {
        "local_spearman": {
            "test": "Wilcoxon signed-rank test against zero",
            "multiple_comparison_correction": "Holm-Bonferroni"
        },
        "local_cosine": {
            "test": "Bootstrap confidence intervals",
            "reason": "Zero is not treated as a generic null expectation for cosine similarity."
        }
    }
}